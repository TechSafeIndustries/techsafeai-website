---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from './PageHero.astro';
import CtaBand from './CtaBand.astro';

interface Props {
  title: string;
  eyebrow: string;
  intro: string;
  description?: string;
  backHref?: string;
  backLabel?: string;
  noindex?: boolean;
}
const { title, eyebrow, intro, description, backHref, backLabel, noindex = false } = Astro.props;
---
<BaseLayout title={title} description={description ?? intro} noindex={noindex}>
  <PageHero {eyebrow} {title} {intro} {backHref} {backLabel} />
  <slot />
  <CtaBand />
</BaseLayout>
