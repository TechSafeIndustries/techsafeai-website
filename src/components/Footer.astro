---
import { navigation } from '../data/navigation';
import BrandMark from './BrandMark.astro';
---
<footer class="site-footer">
  <div class="shell footer-grid">
    <div>
      <a class="brand footer-brand" href="/" aria-label="TechSafeAI home">
        <BrandMark size={26} />
        <span class="wordmark">TechSafeAI</span>
      </a>
      <p>A governed Operational Intelligence platform for high-risk industries.</p>
      <p class="footer-parent-brand">TechSafeAI is part of the TechSafe Industries group.</p>
    </div>
    <div>
      <h2 class="footer-heading">Website</h2>
      <ul>
        {navigation.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </div>
    <div>
      <h2 class="footer-heading">Information</h2>
      <ul>
        <li><a href="/privacy">Privacy</a></li>
        <li><a href="/terms">Website terms</a></li>
        <li><a href="/accessibility">Accessibility</a></li>
        <li><a href="/contact">Contact</a></li>
      </ul>
    </div>
  </div>
  <div class="shell footer-bottom">
    <span>© 2026 TechSafeAI.</span>
  </div>
</footer>
