---
/**
 * TechSafeAI mark — faithful vector recreation of the Founder-supplied
 * logo (31 Aug 2026): isometric cube inside a pointy-top hexagon with a
 * bottom connector strut, flat cyan #06E8F0 (sampled from the supplied
 * asset). Not an interpretation — geometry and colour traced from the
 * reference at 16x zoom.
 */
interface Props {
  size?: number;
  class?: string;
}
const { size = 28, class: cls = '' } = Astro.props;
---
<svg
  class={`brand-mark ${cls}`.trim()}
  width={size}
  height={Math.round(size * 1.1)}
  viewBox="0 0 60 66"
  fill="none"
  stroke="#06E8F0"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  <!-- outer hexagon -->
  <path stroke-width="5" d="M30 3.6 54.4 17.7c.4.23.6.65.6 1.1v28.4c0 .45-.2.87-.6 1.1L30 62.4 5.6 48.3c-.4-.23-.6-.65-.6-1.1V18.8c0-.45.2-.87.6-1.1z"/>
  <!-- inner cube: hexagon silhouette -->
  <path stroke-width="4" d="M30 19 42.1 26v14L30 47 17.9 40V26z"/>
  <!-- cube edges: top-face rhombus V + front vertical -->
  <path stroke-width="4" d="M17.9 26 30 33l12.1-7M30 33v14"/>
  <!-- bottom connector strut -->
  <path stroke-width="4" d="M30 47V62"/>
</svg>
