---
/**
 * WEB-PHASE-10 S6-HERO-2 — TechSafeAI hex-shield mark (Founder-supplied
 * reference, 31 Aug 2026). Redrawn as crisp inline SVG in the canonical
 * Aqua system (no colours outside brand canon). Interim implementation of
 * the Founder's supplied logo direction; Brand workstream 01 remains the
 * canonical authority for final lockup files.
 */
interface Props {
  size?: number;
  class?: string;
}
const { size = 28, class: cls = '' } = Astro.props;
const uid = `bm${Math.random().toString(36).slice(2, 7)}`;
---
<svg
  class={`brand-mark ${cls}`.trim()}
  width={size}
  height={size}
  viewBox="0 0 32 32"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <linearGradient id={uid} x1="4" y1="4" x2="28" y2="28" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="#6FCEFB"/>
      <stop offset="1" stop-color="#2DB8F9"/>
    </linearGradient>
  </defs>
  <path
    d="M16 1.8 27.6 8.5c.6.35 1 1 1 1.73v11.54c0 .72-.4 1.38-1 1.73L16 30.2 4.4 23.5c-.6-.35-1-1-1-1.73V10.23c0-.72.4-1.38 1-1.73z"
    stroke={`url(#${uid})`}
    stroke-width="1.9"
    stroke-linejoin="round"
  />
  <path
    d="M16 8.6c2.2 1.35 4.1 1.62 5.6 1.7v5.2c0 3.6-2.5 5.9-5.6 7.1-3.1-1.2-5.6-3.5-5.6-7.1v-5.2c1.5-.08 3.4-.35 5.6-1.7z"
    stroke={`url(#${uid})`}
    stroke-width="1.7"
    stroke-linejoin="round"
  />
  <path d="M13.4 15.6l2 2 3.4-3.9" stroke={`url(#${uid})`} stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
</svg>
