---
interface Props {
  title?: string;
  copy?: string;
}
const {
  title = 'Start with the problem.',
  copy = 'Share preliminary business context only. Protected information belongs behind a controlled security and intake decision.'
} = Astro.props;
---
<section class="cta-band section-dark">
  <div class="shell cta-band-grid">
    <div>
      <div class="eyebrow">Start with your challenge</div>
      <h2>{title}</h2>
    </div>
    <div>
      <p>{copy}</p>
      <a class="button button-primary" href="/start-with-your-challenge">Start with your challenge <span aria-hidden="true">→</span></a>
    </div>
  </div>
</section>
