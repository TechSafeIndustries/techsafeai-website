---
import { navigation } from '../data/navigation';
---
<header class="site-header">
  <div class="shell header-inner">
    {/* Project 03 governed lockup (canonical brand asset ingest, claude/10).
        Website consumes approved brand assets; brand authority is Project 01. */}
    <a class="brand" href="/" aria-label="TechSafeAI home">
      <img class="brand-lockup" src="/brand/techsafeai/lockup_header_64px_dark.png" alt="TechSafeAI" width="380" height="64" />
    </a>
    <nav class="desktop-nav" aria-label="Primary navigation">
      {navigation.map((item) => <a href={item.href}>{item.label}</a>)}
      <a class="button button-small button-primary" href="/start-with-your-challenge">Start with your challenge</a>
    </nav>
    <details class="mobile-nav">
      <summary aria-label="Open navigation">Menu</summary>
      <nav aria-label="Mobile navigation">
        {navigation.map((item) => <a href={item.href}>{item.label}</a>)}
        <a class="button button-primary" href="/start-with-your-challenge">Start with your challenge</a>
      </nav>
    </details>
  </div>
</header>
