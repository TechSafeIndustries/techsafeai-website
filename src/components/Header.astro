---
import { navigation } from '../data/navigation';
import BrandMark from './BrandMark.astro';
---
<header class="site-header">
  <div class="shell header-inner">
    {/* LOCKED TechSafeAI lockup per Founder logo specification (31 Aug 2026):
        hex-cube network mark (#00E5FF) + TechSafe (medium) / AI (ultra-light).
        Do not restyle without Founder authority. */}
    <a class="brand" href="/" aria-label="TechSafeAI home">
      <BrandMark size={34} />
      <span class="wordmark">TechSafe<span class="wordmark-ai">AI</span></span>
    </a>
    <nav class="desktop-nav" aria-label="Primary navigation">
      {navigation.map((item) => <a href={item.href}>{item.label}</a>)}
      <a class="button button-small button-primary" href="/start-with-your-challenge">Start with your challenge</a>
    </nav>
    <details class="mobile-nav">
      <summary aria-label="Open navigation">Menu</summary>
      <nav aria-label="Mobile navigation">
        {navigation.map((item) => <a href={item.href}>{item.label}</a>)}
        <a class="button button-primary" href="/start-with-your-challenge">Start with your challenge</a>
      </nav>
    </details>
  </div>
</header>
