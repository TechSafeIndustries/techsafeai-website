---
import { navigation } from '../data/navigation';
import BrandMark from './BrandMark.astro';
---
<header class="site-header">
  <div class="shell header-inner">
    {/* Interim Montserrat-set TechSafeAI wordmark (Founder ruling, 31 Aug 2026):
        implementation-only, not a new canonical logo. Replaced when Brand
        workstream 01 supplies the governed TechSafeAI-first lockup. */}
    <a class="brand" href="/" aria-label="TechSafeAI home">
      <BrandMark size={30} />
      <span class="wordmark">TechSafeAI</span>
    </a>
    <nav class="desktop-nav" aria-label="Primary navigation">
      {navigation.map((item) => <a href={item.href}>{item.label}</a>)}
      <a class="button button-small button-primary" href="/start-with-your-challenge">Start with your challenge</a>
    </nav>
    <details class="mobile-nav">
      <summary aria-label="Open navigation">Menu</summary>
      <nav aria-label="Mobile navigation">
        {navigation.map((item) => <a href={item.href}>{item.label}</a>)}
        <a class="button button-primary" href="/start-with-your-challenge">Start with your challenge</a>
      </nav>
    </details>
  </div>
</header>
