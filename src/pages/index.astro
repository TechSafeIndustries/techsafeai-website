---
import BaseLayout from '../layouts/BaseLayout.astro';
import Cockpit from '../components/Cockpit.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import { site } from '../data/site';

const productCards = [
  {
    title: 'Operational Intelligence',
    summary: 'Connects activities, risks, controls and evidence from your existing systems into governed operational context.'
  },
  {
    title: 'Control & Evidence Intelligence',
    summary: 'Surfaces what evidence exists, what is missing and where a control claim is not yet supported.'
  },
  {
    title: 'SAI',
    summary: 'Helps people ask better questions of governed operational information. SAI assists the human — it does not decide for them.'
  },
  {
    title: 'Portfolio & Trend Intelligence',
    summary: 'Shows change and pattern across sites and time, so attention goes where it is actually needed.'
  }
] as const;

const threePs = [
  { title: 'People', summary: 'Capability, readiness and human performance.', icon: 'person' },
  { title: 'Property', summary: 'Assets, infrastructure and operational capability.', icon: 'building' },
  { title: 'Planet', summary: 'Environmental conditions, obligations and constraints.', icon: 'globe' }
] as const;

const engagementPaths = [
  {
    title: 'Product Services',
    summary: 'Governed Operational Intelligence delivered through the TechSafeAI platform — Cockpit, SAI, Evidence Intelligence and Human Review.',
    href: '/product'
  },
  {
    title: 'Consultancy Services',
    summary: 'Human-led expertise: assurance, risk and operational reviews, control verification, incident investigation and implementation support.',
    href: '/consulting'
  }
] as const;

// WEB-PHASE-10 S4 — names below are Founder-supplied governed lists (WEB-PHASE-10
// mission / S4 directive). No availability, maturity or compliance status is stated.
const supportFunctions = [
  ['Contractor Management', 'Contractor context alongside operational risk.', 'id-badge'],
  ['Governance & Compliance', 'Obligations and governance context, kept visible.', 'shield-check'],
  ['Risk & Control Verification', 'Controls and verification context, kept visible.', 'target'],
  ['Quality Assurance', 'Quality context connected to operational activity.', 'seal-check'],
  ['Data & Reporting', 'Reporting grounded in governed, cited information.', 'chart'],
  ['Systems & Technology', 'Systems and technology connected to the operational picture.', 'chip'],
  ['Incident Learning', 'What happened, what it touched, what changed after.', 'loop'],
  ['Stakeholder & Communications', 'The people and parties affected by operational conditions.', 'people']
] as const;

const productCapabilities = [
  'Operational Intelligence Cockpit', 'SAI Assistant', 'Risk & Activity Intelligence',
  'Compliance & Evidence Adapters', 'Incident Learning', 'Contractor Management', 'Integrations & Connectors'
] as const;

const consultancyCapabilities = [
  'Strategy and operational advisory', 'Operational reviews', 'Risk and assurance',
  'System design and implementation', 'Capability uplift', 'Training', 'Change and adoption'
] as const;

const integrationCategories = [
  'ERP', 'HR', 'LMS', 'Environmental systems', 'Inspection platforms',
  'Document systems', 'Power BI', 'SharePoint', 'IoT / GIS'
] as const;

const valueOutcomes = [
  'Better operational understanding', 'Improved evidence visibility',
  'Faster human review', 'Stronger audit preparation'
] as const;

const industryLinks = [
  { slug: 'mining-resources', title: 'Mining & Resources' },
  { slug: 'construction-infrastructure', title: 'Construction & Infrastructure' },
  { slug: 'other-regulated-operations', title: 'Other Risk-Intensive & Regulated Operations' }
] as const;
---
<BaseLayout title={site.name} description="TechSafeAI brings governed operational information into context, helping leaders see what needs attention, understand the evidence behind it and make better-informed decisions.">

  <section class="hero section-dark">
    <div class="hero-wrap">
      <div class="hero-head">
        <div class="eyebrow">Governed Operational Intelligence</div>
        <h1>Operational information is everywhere.<span>Operational understanding isn't.</span></h1>
      </div>
      <div class="hero-copy">
        <p class="lead">TechSafeAI brings governed operational information into context, helping leaders see what needs attention, understand the evidence behind it and make better-informed decisions.</p>
        <div class="hero-actions">
          <a class="button button-primary" href="/start-with-your-challenge">Start with your challenge <span aria-hidden="true">→</span></a>
          <a class="button button-outline-light" href="#operational-intelligence">See how it works</a>
        </div>
      </div>
      <div class="cockpit-stage">
        <div class="cockpit-bloom" aria-hidden="true"></div>
        <Cockpit />
        <span class="cockpit-callout a">Operational Intelligence Cockpit</span>
        <span class="cockpit-callout b">SAI assists the human.</span>
      </div>
    </div>
  </section>

  <section class="trust-strip">
    <div class="shell">
      <span><Icon name="layers" size={20} /><span class="trust-copy"><strong>Your existing systems</strong> remain authoritative</span></span>
      <span><Icon name="doc-check" size={20} /><span class="trust-copy"><strong>Evidence and provenance</strong> stay visible</span></span>
      <span><Icon name="person" size={20} /><span class="trust-copy"><strong>Human decisions</strong> remain human</span></span>
    </div>
  </section>

  <section class="section section-light" id="three-ps">
    <div class="shell">
      <div class="section-title title-stack"><div class="eyebrow">People + Property + Planet</div><h2>One operation. Three connected perspectives.</h2><p>Conditions across these three domains may affect operational performance and productivity. TechSafeAI does not guarantee productivity, profitability or compliance outcomes — it helps connect the intelligence that informs them.</p></div>
      <div class="p3-grid reveal-group">
        {threePs.map((p)=>(
          <article class="p3-card">
            <div class="p3-head">
              <span class="p3-icon-tile" aria-hidden="true"><Icon name={p.icon} size={24} /></span>
              <h3>{p.title}</h3>
            </div>
            <p>{p.summary}</p>
            <span class="p3-wm" aria-hidden="true"><Icon name={p.icon} size={104} /></span>
          </article>
        ))}
      </div>
      <div class="p3-chain">
        <span>Operational conditions</span><i aria-hidden="true"></i>
        <span>Operational performance</span><i aria-hidden="true"></i>
        <span>Productivity</span><i aria-hidden="true"></i>
        <span>Business performance / value</span>
      </div>
    </div>
  </section>

  <section class="section how-section">
    <div class="shell problem-grid">
      <div class="section-title title-stack"><div class="eyebrow">The problem isn't another dashboard</div><h2>Existing systems can show what they contain.</h2><p>Dashboards can visualise it. Generic AI can summarise it. None of that is the same as understanding how it fits together.</p></div>
      <div class="problem-list">
        <div class="problem-row"><span class="code">01</span><div><h3>Existing systems</h3><p>Can show what they contain — inside their own boundary, in their own format.</p></div><span class="cause">Shows its own data</span></div>
        <div class="problem-row"><span class="code">02</span><div><h3>Dashboards</h3><p>Can visualise it — a clearer picture of the same disconnected information.</p></div><span class="cause">Visualises, doesn't connect</span></div>
        <div class="problem-row"><span class="code">03</span><div><h3>Generic AI</h3><p>Can summarise it — without knowing what is governed, evidenced or still uncertain.</p></div><span class="cause">Summarises, doesn't govern</span></div>
      </div>
      <p class="notice" style="grid-column:1/-1;margin-top:8px">TechSafeAI is being built to understand governed operational relationships across activities, risks, controls, evidence and organisational context — not to add another view of the same fragmented information.</p>
    </div>
    <div class="shell">
      <p class="flow-kicker">How TechSafeAI works</p>
      <div class="flow-rail reveal-group">
        <div class="flow-step"><span class="flow-top"><span class="flow-num">01</span><Icon name="compass" size={20} class="flow-icon" /></span><span class="flow-label">Challenge</span><p>Start with context, not confidential files.</p><i class="flow-arrow" aria-hidden="true"></i></div>
        <div class="flow-step"><span class="flow-top"><span class="flow-num">02</span><Icon name="nodes" size={20} class="flow-icon" /></span><span class="flow-label">Context</span><p>TechSafeAI connects, structures and explains governed information from the systems you already run.</p><i class="flow-arrow" aria-hidden="true"></i></div>
        <div class="flow-step"><span class="flow-top"><span class="flow-num">03</span><Icon name="doc-check" size={20} class="flow-icon" /></span><span class="flow-label">Evidence</span><p>Surfaces what evidence exists, what is missing and where a control claim is not yet supported.</p><i class="flow-arrow" aria-hidden="true"></i></div>
        <div class="flow-step"><span class="flow-top"><span class="flow-num">04</span><Icon name="person-check" size={20} class="flow-icon" /></span><span class="flow-label">Human review</span><p>Human decisions remain human.</p></div>
      </div>
    </div>
  </section>

  <section class="section section-muted" id="operational-intelligence">
    <div class="shell">
      <div class="section-title" style="display:block"><div class="eyebrow">Product story</div><h2>Operational Intelligence without replacing the systems that own your data.</h2><p>TechSafeAI connects, structures and explains governed information from the systems you already run. It does not become a new system of record.</p></div>
      <div class="capability-grid grid-lead">
        {productCards.map((card,index)=>(
          <div class="capability">
            <span class="capability-index">0{index+1}</span>
            <h3>{card.title}</h3>
            <p>{card.summary}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-cool">
    <div class="shell content-grid">
      <div>
        <div class="eyebrow">Systems Assistant Intelligence</div>
        <h2>Ask better questions of your operational information.</h2>
        <p class="lead">SAI assists the human.</p>
      </div>
      <div class="content-copy">
        <p>SAI is contextual, evidence-grounded and human-supervised. It helps people explore governed operational information and understand the evidence behind it.</p>
        <p class="notice">SAI does not manufacture operational truth, autonomously approve work, determine compliance, or replace a competent person's judgement.</p>
        <figure class="sai-figure">
          <img
            src="/assets/sai/website-handoff/sai-ui-016/SAI-GROUNDED-INTERACTION-37a6918.png"
            width="621"
            height="547"
            alt="SAI grounded explanation interface showing source-based operational context using synthetic demonstration data."
            loading="lazy"
          />
          <figcaption class="notice">Product interface shown with synthetic demonstration data. SAI explains and cites its sources — it decides nothing.</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="section section-light">
    <div class="shell">
      <div class="section-title title-stack"><div class="eyebrow">Support Functions</div><h2>One integrated support layer.</h2></div>
      <div class="support-grid reveal-group">
        {supportFunctions.map(([title, copy, icon])=>(
          <div class="support-tile">
            <div class="support-head"><Icon name={icon} size={20} class="support-icon" /><h3>{title}</h3></div>
            <p>{copy}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section split-section">
    <div class="shell">
      <div class="section-title title-stack"><div class="eyebrow">Ways to engage</div><h2>Two ways to work with TechSafeAI.</h2></div>
      <div class="split-grid grid-lead">
        <a class="split-panel" href={engagementPaths[0].href}>
          <span class="split-kicker"><Icon name="grid" size={18} /> Product Services</span>
          <p>{engagementPaths[0].summary}</p>
          <ul>
            {productCapabilities.map((name)=>(<li>{name}</li>))}
          </ul>
          <span class="route-link">Learn more →</span>
        </a>
        <a class="split-panel split-panel-consult" href={engagementPaths[1].href}>
          <span class="split-kicker"><Icon name="person" size={18} /> Consultancy Services</span>
          <p>{engagementPaths[1].summary}</p>
          <ul>
            {consultancyCapabilities.map((name)=>(<li>{name}</li>))}
          </ul>
          <span class="split-wm" aria-hidden="true"><Icon name="person" size={92} /></span>
          <span class="route-link">Learn more →</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section section-light section-tight">
    <div class="shell">
      <div class="section-title title-stack"><div class="eyebrow">Evidence &amp; Human Review</div><h2>Evidence-led. Human review.</h2></div>
      <div class="boundary-band grid-lead">
        <div class="boundary-side">
          <span class="split-kicker"><Icon name="doc-check" size={18} /> SAI assists</span>
          <ul>
            <li>SAI explains and cites its sources — consequential decisions remain human.</li>
            <li>Helps people ask better questions of governed operational information.</li>
            <li>Contextual, evidence-grounded and human-supervised.</li>
          </ul>
        </div>
        <div class="boundary-divider" aria-hidden="true"></div>
        <div class="boundary-side">
          <span class="split-kicker"><Icon name="person-check" size={18} /> Humans decide</span>
          <ul>
            <li>TechSafeAI does not determine legal compliance.</li>
            <li>It does not accept risk or authorise consequential work.</li>
            <li>It does not make regulatory interpretations.</li>
            <li>It does not create unsupported operational facts.</li>
          </ul>
        </div>
      </div>
      <div class="boundary-flow" aria-hidden="true">
        <i class="bf-line l"><span class="bf-dot"></span><span class="bf-dot"></span><span class="bf-dot"></span></i>
        <span class="bf-rings"><i></i><i></i></span>
        <span class="bf-human"><Icon name="person" size={14} /></span>
        <i class="bf-line r"></i>
      </div>
    </div>
  </section>

  <section class="section integrations-section">
    <div class="shell">
      <div class="section-title title-stack"><div class="eyebrow">Integration-ready</div><h2>Built to sit beside the systems you already run.</h2><p>Your existing systems remain authoritative — TechSafeAI does not become a new system of record. Integrations are scoped per deployment.</p></div>
      <div class="integration-chips grid-lead">
        {integrationCategories.map((name)=>(<span class="integration-chip">{name}</span>))}
      </div>
      <div class="int-network" aria-label="System categories TechSafeAI is designed to connect to">
        <svg class="int-links" viewBox="0 0 1100 520" aria-hidden="true">
          <circle class="int-orbit" cx="550" cy="260" r="150" />
          <circle class="int-orbit" cx="550" cy="260" r="235" />
          <path d="M 550 96 L 550 178" />
          <path d="M 762 128 L 618 210" />
          <path d="M 858 260 L 636 260" />
          <path d="M 780 408 L 622 316" />
          <path d="M 550 448 L 550 342" />
          <path d="M 320 410 L 480 318" />
          <path d="M 242 260 L 464 260" />
          <path d="M 318 116 L 482 206" />
          <path d="M 688 62 L 594 190" />
        </svg>
        <div class="int-hub">TechSafeAI</div>
        <span class="int-node" style="--x:50%;--y:14%">ERP</span>
        <span class="int-node" style="--x:70.5%;--y:22%">HR</span>
        <span class="int-node" style="--x:79%;--y:50%">LMS</span>
        <span class="int-node" style="--x:71.5%;--y:80%">Environmental systems</span>
        <span class="int-node" style="--x:50%;--y:88.5%">Inspection platforms</span>
        <span class="int-node" style="--x:28.5%;--y:80.5%">Document systems</span>
        <span class="int-node" style="--x:21%;--y:50%">Power BI</span>
        <span class="int-node" style="--x:28.5%;--y:20.5%">SharePoint</span>
        <span class="int-node" style="--x:63%;--y:9.5%">IoT / GIS</span>
      </div>
    </div>
  </section>

  <section class="section section-cool">
    <div class="shell">
      <div class="section-title title-stack"><div class="eyebrow">Industries</div><h2>Featured depth, and a route for every high-risk operation.</h2><p>Mining & Resources and Construction & Infrastructure are the featured initial sector depth. Other high-risk operations have a credible route without unsupported specialist claims.</p></div>
      <div class="industry-grid grid-lead">
        {industryLinks.map((industry, index)=>(
          <a class={`industry-card ${index < 2 ? 'industry-card-featured' : ''}`} href={`/industries/${industry.slug}`}>
            <h3>{industry.title}</h3>
            <span class="route-link">View industry →</span>
            {index === 0 && <svg class="industry-terrain" viewBox="0 0 400 78" preserveAspectRatio="none" aria-hidden="true"><path d="M0 70 L60 70 L80 56 L150 56 L170 42 L240 42 L260 28 L330 28 L350 14 L400 14" stroke="currentColor" stroke-width="1.5" fill="none"/><path d="M0 78 L90 78 L110 64 L190 64 L210 50 L290 50 L310 36 L400 36" stroke="currentColor" stroke-width="1" fill="none" opacity=".5"/></svg>}
            {index === 1 && <svg class="industry-terrain" viewBox="0 0 400 78" preserveAspectRatio="none" aria-hidden="true"><path d="M40 78 V26 M40 26 L120 78 M120 78 V18 M120 18 L210 78 M210 78 V30 M210 30 L300 78 M300 78 V12 M300 12 L380 60" stroke="currentColor" stroke-width="1.5" fill="none"/><path d="M20 78 H400" stroke="currentColor" stroke-width="1" opacity=".5"/></svg>}
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section value-section">
    <div class="shell">
      <div class="section-title title-stack"><div class="eyebrow">Value</div><h2>What changes in how you work.</h2><p>TechSafeAI does not guarantee productivity, profitability or compliance outcomes — it helps connect the intelligence that informs them.</p></div>
      <div class="value-grid reveal-group">
        {valueOutcomes.map((name)=>(<div class="value-panel"><h3>{name}</h3><i class="value-sheen" aria-hidden="true"></i></div>))}
      </div>
    </div>
  </section>

  <CtaBand title="Operational Intelligence backed by operational expertise." copy="A person from TechSafeAI reviews every enquiry. Your existing systems remain authoritative and human decisions remain human." />

  <script src="../scripts/premium/index.ts"></script>
</BaseLayout>

<style>
  .sai-figure{margin:20px 0 0;max-width:621px}
  .sai-figure img{display:block;width:100%;height:auto;max-width:621px;border:1px solid var(--border)}
  .sai-figure figcaption{margin-top:10px}
</style>
