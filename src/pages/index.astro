---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import { site } from '../data/site';

const productCards = [
  {
    title: 'Operational Intelligence',
    summary: 'Connects activities, risks, controls and evidence from your existing systems into governed operational context.'
  },
  {
    title: 'Control & Evidence Intelligence',
    summary: 'Surfaces what evidence exists, what is missing and where a control claim is not yet supported.'
  },
  {
    title: 'SAI',
    summary: 'Helps people ask better questions of governed operational information. SAI assists the human — it does not decide for them.'
  },
  {
    title: 'Portfolio & Trend Intelligence',
    summary: 'Shows change and pattern across sites and time, so attention goes where it is actually needed.'
  }
] as const;

const threePs = [
  { title: 'People', summary: 'Capability, readiness and human performance.' },
  { title: 'Property', summary: 'Assets, infrastructure and operational capability.' },
  { title: 'Planet', summary: 'Environmental conditions, obligations and constraints.' }
] as const;

const engagementPaths = [
  {
    title: 'Product Services',
    summary: 'Governed Operational Intelligence delivered through the TechSafeAI platform — Cockpit, SAI, Evidence Intelligence and Human Review.',
    href: '/product'
  },
  {
    title: 'Consultancy Services',
    summary: 'Human-led expertise: assurance, risk and operational reviews, control verification, incident investigation and implementation support.',
    href: '/consulting'
  }
] as const;

const industryLinks = [
  { slug: 'mining-resources', title: 'Mining & Resources' },
  { slug: 'construction-infrastructure', title: 'Construction & Infrastructure' },
  { slug: 'other-regulated-operations', title: 'Other Risk-Intensive & Regulated Operations' }
] as const;
---
<BaseLayout title={site.name} description="TechSafeAI brings governed operational information into context, helping leaders see what needs attention, understand the evidence behind it and make better-informed decisions.">

  <section class="hero section-dark">
    <div class="shell hero-grid">
      <div class="hero-copy">
        <div class="eyebrow">Governed Operational Intelligence</div>
        <h1>Operational information is everywhere.<span>Operational understanding isn't.</span></h1>
        <p class="lead">TechSafeAI brings governed operational information into context, helping leaders see what needs attention, understand the evidence behind it and make better-informed decisions.</p>
        <div class="hero-actions">
          <a class="button button-primary" href="/start-with-your-challenge">Start with your challenge <span aria-hidden="true">→</span></a>
          <a class="button button-outline-light" href="#operational-intelligence">See how it works</a>
        </div>
        <div class="trustline">
          <span><strong>Your existing systems</strong> remain authoritative</span>
          <span><strong>Evidence and provenance</strong> stay visible</span>
          <span><strong>Human decisions</strong> remain human</span>
        </div>
      </div>
      <div class="hero-art" aria-hidden="true">
        <div class="hero-art-grid"></div>
        <span class="art-node a"></span><span class="art-node b"></span><span class="art-node c"></span>
        <span class="art-label a">Activities</span>
        <span class="art-label b">Risks / controls</span>
        <span class="art-label c">Evidence</span>
        <div class="art-caption"><div><strong>Operational context</strong>High-risk industries</div><div><strong>Governed intelligence</strong>Context → evidence → decision</div></div>
      </div>
    </div>
  </section>

  <section class="section section-light">
    <div class="shell problem-grid">
      <div class="section-title" style="display:block"><div class="eyebrow">The problem isn't another dashboard</div><h2>Existing systems can show what they contain.</h2><p>Dashboards can visualise it. Generic AI can summarise it. None of that is the same as understanding how it fits together.</p></div>
      <div class="problem-list">
        <div class="problem-row"><span class="code">01</span><div><h3>Existing systems</h3><p>Can show what they contain — inside their own boundary, in their own format.</p></div><span class="cause">Shows its own data</span></div>
        <div class="problem-row"><span class="code">02</span><div><h3>Dashboards</h3><p>Can visualise it — a clearer picture of the same disconnected information.</p></div><span class="cause">Visualises, doesn't connect</span></div>
        <div class="problem-row"><span class="code">03</span><div><h3>Generic AI</h3><p>Can summarise it — without knowing what is governed, evidenced or still uncertain.</p></div><span class="cause">Summarises, doesn't govern</span></div>
      </div>
      <p class="notice" style="grid-column:1/-1;margin-top:8px">TechSafeAI is being built to understand governed operational relationships across activities, risks, controls, evidence and organisational context — not to add another view of the same fragmented information.</p>
    </div>
  </section>

  <section class="section section-muted" id="operational-intelligence">
    <div class="shell">
      <div class="section-title" style="display:block"><div class="eyebrow">Product story</div><h2>Operational Intelligence without replacing the systems that own your data.</h2><p>TechSafeAI connects, structures and explains governed information from the systems you already run. It does not become a new system of record.</p></div>
      <div class="capability-grid" style="margin-top:42px">
        {productCards.map((card,index)=>(
          <div class="capability">
            <span class="capability-index">0{index+1}</span>
            <h3>{card.title}</h3>
            <p>{card.summary}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-light" id="three-ps">
    <div class="shell">
      <div class="section-title" style="display:block"><div class="eyebrow">People + Property + Planet</div><h2>One operation. Three connected perspectives.</h2><p>Conditions across these three domains may affect operational performance and productivity. TechSafeAI does not guarantee productivity, profitability or compliance outcomes — it helps connect the intelligence that informs them.</p></div>
      <div class="capability-grid" style="margin-top:42px">
        {threePs.map((p)=>(
          <div class="capability">
            <h3>{p.title}</h3>
            <p>{p.summary}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-muted">
    <div class="shell content-grid">
      <div>
        <div class="eyebrow">Systems Assistant Intelligence</div>
        <h2>Ask better questions of your operational information.</h2>
        <p class="lead">SAI assists the human.</p>
      </div>
      <div class="content-copy">
        <p>SAI is contextual, evidence-grounded and human-supervised. It helps people explore governed operational information and understand the evidence behind it.</p>
        <p class="notice">SAI does not manufacture operational truth, autonomously approve work, determine compliance, or replace a competent person's judgement.</p>
      </div>
    </div>
  </section>

  <section class="content-section">
    <div class="shell">
      <div class="section-title"><div><div class="eyebrow">Ways to engage</div><h2>Two ways to work with TechSafeAI.</h2></div></div>
      <div class="route-grid" style="margin-top:42px">
        {engagementPaths.map((path)=>(
          <a class="route-card" href={path.href}>
            <h3>{path.title}</h3>
            <p>{path.summary}</p>
            <span class="route-link">Learn more →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="content-section" style="background:#e8e5dd">
    <div class="shell">
      <div class="section-title"><div><div class="eyebrow">Industries</div><h2>Featured depth, and a route for every high-risk operation.</h2></div><p>Mining & Resources and Construction & Infrastructure are the featured initial sector depth. Other high-risk operations have a credible route without unsupported specialist claims.</p></div>
      <div class="route-grid" style="margin-top:42px">
        {industryLinks.map((industry)=>(
          <a class="route-card" href={`/industries/${industry.slug}`}>
            <h3>{industry.title}</h3>
            <span class="route-link">View industry →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <CtaBand title="Operational Intelligence backed by operational expertise." copy="A person from TechSafeAI reviews every enquiry. Your existing systems remain authoritative and human decisions remain human." />

</BaseLayout>
