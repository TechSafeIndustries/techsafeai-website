---
import BaseLayout from '../layouts/BaseLayout.astro';
import Cockpit from '../components/Cockpit.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import BrandMark from '../components/BrandMark.astro';
import { site } from '../data/site';

const threePs = [
  { title: 'People', summary: 'Capability, readiness and human performance.', icon: 'person' },
  { title: 'Property', summary: 'Assets, infrastructure and operational capability.', icon: 'building' },
  { title: 'Planet', summary: 'Environmental conditions, obligations and constraints.', icon: 'globe' }
] as const;

const engagementPaths = [
  {
    title: 'Product Services',
    summary: 'Governed Operational Intelligence delivered through the TechSafeAI platform — Cockpit, SAI, Evidence Intelligence and Human Review.',
    href: '/product'
  },
  {
    title: 'Consultancy Services',
    summary: 'Human-led expertise: assurance, risk and operational reviews, control verification, incident investigation and implementation support.',
    href: '/consulting'
  }
] as const;

// claude/109 — HOMEPAGE DOWNSTREAM MISSION: 8 support functions grouped into
// 4 clusters (max per brief). Cluster copy recombines the original governed
// phrase fragments only — no new capability claims introduced.
const supportFunctions = [
  ['People & Contractor Assurance', 'Contractor context and stakeholder communications, connected to operational risk.', 'id-badge'],
  ['Governance, Risk & Control', 'Obligations, controls and verification, kept visible and connected.', 'shield-check'],
  ['Evidence, Data & Learning', 'Reporting grounded in governed, cited information — and what changed after.', 'chart'],
  ['Systems & Technology', 'Systems and technology connected to the operational picture.', 'chip']
] as const;

// claude/109 — compact split per brief: Product = platform / cockpit /
// governed intelligence; Consulting = human-led expertise / assurance /
// implementation support. Full lists stay on /product and /consulting.
const productCapabilities = [
  'Operational Intelligence platform', 'Operational Intelligence Cockpit', 'SAI & governed intelligence'
] as const;

const consultancyCapabilities = [
  'Human-led expertise', 'Assurance & operational reviews', 'TechSafeAI implementation support'
] as const;

const valueOutcomes = [
  { name: 'Better operational understanding', icon: 'nodes' },
  { name: 'Improved evidence visibility', icon: 'eye' },
  { name: 'Better supported human review', icon: 'person-check' },
  { name: 'Stronger audit preparation', icon: 'doc-check' }
] as const;

const industryLinks = [
  { slug: 'mining-resources', title: 'Mining & Resources', icon: 'pick' },
  { slug: 'construction-infrastructure', title: 'Construction & Infrastructure', icon: 'crane' },
  { slug: 'other-regulated-operations', title: 'Other Risk-Intensive & Regulated Operations', icon: 'shield-check' }
] as const;
---
<BaseLayout title={site.name} description="TechSafeAI brings governed operational information into context, helping leaders see what needs attention, understand the evidence behind it and make better-informed decisions.">

  <section class="hero section-dark">
    <div class="hero-env" aria-hidden="true"></div>
    <div class="hero-wrap">
      <div class="hero-copy">
        <div class="eyebrow eyebrow-ghost">Governed Operational Intelligence</div>
        <h1>Operational information is everywhere.<span>Operational understanding isn't.</span></h1>
        <p class="lead">TechSafeAI brings governed operational information into context, helping leaders see what needs attention, understand the evidence behind it and make better-informed decisions.</p>
        <div class="hero-actions">
          <a class="button button-primary" href="/start-with-your-challenge">Start with your challenge <span aria-hidden="true">→</span></a>
          <a class="button button-outline-light" href="#operational-intelligence">See how it works</a>
        </div>
      </div>
      <div class="cockpit-stage">
        <svg class="hero-topology" viewBox="0 0 900 620" preserveAspectRatio="none" aria-hidden="true">
          <g stroke="rgba(0,229,255,.30)" stroke-width="1" fill="none">
            <path class="tp" d="M118 96 H236 L294 148"/>
            <path class="tp" d="M842 128 H744 L700 172"/>
            <path class="tp" d="M64 486 H244 L330 428 H418"/>
            <path class="tp" d="M852 452 H760 L706 404"/>
          </g>
          <g fill="none" stroke="rgba(0,229,255,.55)" stroke-width="1.2">
            <circle class="tn" cx="118" cy="96" r="3.5"/>
            <circle class="tn" cx="842" cy="128" r="3.5"/>
            <circle class="tn" cx="64" cy="486" r="3.5"/>
            <circle class="tn" cx="852" cy="452" r="3.5"/>
          </g>
        </svg>
        {/* Operational Intelligence Cockpit — instrument bay per the
            Founder-LOCKED visual reference (1 Sep 2026). The governed UI is
            the display content; the bay is the presentation system.
            .laptop / .laptop-screen class names retained as JS hooks. */}
        <div class="laptop">
          <div class="bay-cowl">
            <span class="monolith-plate">Operational Intelligence Cockpit</span>
          </div>
          <div class="bay-frame">
            <i class="bay-side l" aria-hidden="true"></i>
            <i class="bay-side r" aria-hidden="true"></i>
            <div class="laptop-screen">
              <Cockpit />
              <i class="screen-glass" aria-hidden="true"></i>
            </div>
          </div>
          <div class="bay-console">
            <span class="bay-controls" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
            <span class="bay-badge" aria-hidden="true"><BrandMark size={16} compact={true} animated={true} /><span class="bay-badge-word">TechSafe<b>AI</b></span></span>
            <span class="bay-status" aria-hidden="true"><i class="ln"></i><i class="ln"></i><i class="dot"></i></span>
          </div>
          <i class="bay-foot l" aria-hidden="true"></i>
          <i class="bay-foot r" aria-hidden="true"></i>
          <div class="monolith-underglow" aria-hidden="true"></div>
        </div>
        <div class="stage-shadow" aria-hidden="true"></div>
        <div class="monolith-reflection" aria-hidden="true">
          <img
            src="/assets/sai/website-handoff/sai-ui-016/HERO-COCKPIT-37a6918.png"
            width="1506"
            height="692"
            alt=""
            loading="lazy"
            decoding="async"
          />
        </div>
        <span class="sai-tag"><i class="sai-node" aria-hidden="true"></i><i class="sai-line" aria-hidden="true"></i><span class="cockpit-callout b">SAI assists the human.</span></span>
      </div>
    </div>
  </section>

  <section class="trust-strip">
    <div class="shell">
      <span><Icon name="layers" size={20} /><span class="trust-copy"><strong>Your existing systems</strong> remain authoritative</span></span>
      <span><Icon name="doc-check" size={20} /><span class="trust-copy"><strong>Evidence and provenance</strong> stay visible</span></span>
      <span><Icon name="person" size={20} /><span class="trust-copy"><strong>Human decisions</strong> remain human</span></span>
    </div>
  </section>

  <section class="section section-light" id="three-ps">
    <div class="shell">
      <div class="section-title title-stack"><div class="eyebrow">People + Property + Planet</div><h2>One operation. Three connected perspectives.</h2></div>
      <div class="p3-grid reveal-group">
        {threePs.map((p)=>(
          <article class="p3-card">
            <span class="p3-mono" aria-hidden="true">P</span>
            <div class="p3-head">
              <span class="p3-icon-tile" aria-hidden="true"><Icon name={p.icon} size={24} /></span>
              <h3>{p.title}</h3>
            </div>
            <p>{p.summary}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section how-section" id="operational-intelligence">
    <div class="shell">
      <div class="section-title title-stack"><div class="eyebrow">How TechSafeAI works</div><h2>From existing systems to better-informed decisions.</h2><p>TechSafeAI connects, structures and explains governed information from the systems you already run — evidence stays visible, and the decision stays human.</p></div>
      <div class="flow-rail reveal-group">
        <div class="flow-step"><span class="flow-top"><span class="flow-num">01</span><Icon name="layers" size={20} class="flow-icon" /></span><span class="flow-label">Existing systems</span><p>Your systems keep the data — TechSafeAI doesn't replace them.</p><i class="flow-arrow" aria-hidden="true"></i></div>
        <div class="flow-step"><span class="flow-top"><span class="flow-num">02</span><Icon name="nodes" size={20} class="flow-icon" /></span><span class="flow-label">Governed Operational Intelligence</span><p>Connects, structures and explains information from the systems you already run.</p><i class="flow-arrow" aria-hidden="true"></i></div>
        <div class="flow-step"><span class="flow-top"><span class="flow-num">03</span><Icon name="doc-check" size={20} class="flow-icon" /></span><span class="flow-label">Evidence &amp; context</span><p>Surfaces what evidence exists, what's missing and where a claim isn't yet supported.</p><i class="flow-arrow" aria-hidden="true"></i></div>
        <div class="flow-step"><span class="flow-top"><span class="flow-num">04</span><Icon name="person-check" size={20} class="flow-icon" /></span><span class="flow-label">Human review</span><p>Human decisions remain human — leading to better-informed decisions.</p></div>
      </div>
    </div>
  </section>

  <section class="section section-light">
    <div class="shell">
      <div class="section-title title-stack"><div class="eyebrow">Support Functions</div><h2>One integrated support layer.</h2></div>
      <div class="support-grid reveal-group">
        {supportFunctions.map(([title, copy, icon])=>(
          <div class="support-tile">
            <div class="support-head"><Icon name={icon} size={20} class="support-icon" /><h3>{title}</h3></div>
            <p>{copy}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section split-section">
    <div class="shell">
      <div class="section-title title-stack"><div class="eyebrow">Ways to engage</div><h2>Two ways to work with TechSafeAI.</h2></div>
      <div class="split-grid grid-lead">
        <a class="split-panel" href={engagementPaths[0].href}>
          <span class="split-kicker"><span class="kicker-tile" aria-hidden="true"><Icon name="grid" size={16} /></span> Product Services</span>
          <p>{engagementPaths[0].summary}</p>
          <div class="split-media">
            <ul>
              {productCapabilities.map((name)=>(<li>{name}</li>))}
            </ul>
            <figure class="split-inset" aria-hidden="false">
              <img
                src="/assets/sai/website-handoff/sai-ui-016/SAI-GROUNDED-INTERACTION-37a6918.png"
                width="621"
                height="547"
                alt="SAI grounded explanation interface showing source-based operational context using synthetic demonstration data."
                loading="lazy"
              />
            </figure>
          </div>
          <span class="route-link">Learn more →</span>
        </a>
        <a class="split-panel split-panel-consult" href={engagementPaths[1].href}>
          <span class="split-kicker"><span class="kicker-tile" aria-hidden="true"><Icon name="person" size={16} /></span> Consultancy Services</span>
          <p>{engagementPaths[1].summary}</p>
          <div class="split-media">
            <ul>
              {consultancyCapabilities.map((name)=>(<li>{name}</li>))}
            </ul>
            <svg class="split-illustration" viewBox="0 0 260 300" aria-hidden="true">
              <g stroke="rgba(111,206,251,.75)" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
                <path d="M52 96a26 26 0 0152 0"/><path d="M48 96h60"/>
                <circle cx="78" cy="116" r="16"/>
                <path d="M50 190c2-32 12-46 28-46s26 14 28 46"/>
                <path d="M150 76a24 24 0 0148 0"/><path d="M146 76h56"/>
                <circle cx="174" cy="95" r="15"/>
                <path d="M148 168c2-30 11-43 26-43s24 13 26 43"/>
                <rect x="118" y="140" width="34" height="24" rx="3"/>
                <path d="M106 148l12 4M152 150l14-6"/>
              </g>
              <g stroke="rgba(45,184,249,.30)" stroke-width="1.5" fill="none">
                <path d="M20 250h220M40 274h180"/>
              </g>
            </svg>
          </div>
          <span class="route-link">Learn more →</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section section-light section-tight">
    <div class="shell">
      <div class="section-title title-stack"><div class="eyebrow">Evidence &amp; Human Review</div><h2>Evidence-led. Human review.</h2></div>
      <p class="proof-themes">Evidence &amp; Provenance <i aria-hidden="true"></i> Audit Ready <i aria-hidden="true"></i> Human Review <i aria-hidden="true"></i> Secure &amp; Private</p>
      <div class="boundary-band grid-lead">
        <div class="boundary-side">
          <span class="split-kicker"><Icon name="doc-check" size={18} /> Evidence &amp; Provenance</span>
          <ul>
            <li>Evidence stays visible.</li>
            <li>Sources and context remain traceable.</li>
          </ul>
        </div>
        <div class="boundary-divider" aria-hidden="true"></div>
        <div class="boundary-side">
          <span class="split-kicker"><Icon name="person-check" size={18} /> Human Review</span>
          <ul>
            <li>AI assists.</li>
            <li>Humans retain judgement.</li>
          </ul>
        </div>
      </div>
      <div class="boundary-flow" aria-hidden="true">
        <i class="bf-line l"><span class="bf-dot"></span><span class="bf-dot"></span><span class="bf-dot"></span></i>
        <span class="bf-rings"><i></i><i></i></span>
        <span class="bf-human"><Icon name="person" size={14} /></span>
        <i class="bf-line r"></i>
      </div>
    </div>
  </section>

  <section class="section integrations-section">
    <div class="shell">
      <div class="section-title title-stack"><div class="eyebrow">Integration-ready</div><h2>Works with your existing IMS &amp; systems.</h2><p>Your existing systems remain authoritative — TechSafeAI does not become a new system of record. Integrations are scoped per deployment.</p></div>
    </div>
  </section>

  <section class="section section-cool">
    <div class="shell">
      <div class="section-title title-stack"><div class="eyebrow">Industries</div><h2>Featured depth, and a route for every high-risk operation.</h2><p>Mining & Resources and Construction & Infrastructure are the featured initial sector depth. Other high-risk operations have a credible route without unsupported specialist claims.</p></div>
      <div class="industry-grid grid-lead">
        {industryLinks.map((industry, index)=>(
          <a class={`industry-card ${index < 2 ? 'industry-card-featured' : ''}`} href={`/industries/${industry.slug}`}>
            <span class="industry-icon" aria-hidden="true"><Icon name={industry.icon} size={24} /></span>
            <h3>{industry.title}</h3>
            <span class="route-link">View industry →</span>
            {index === 0 && <svg class="industry-terrain" viewBox="0 0 400 78" preserveAspectRatio="none" aria-hidden="true"><path d="M0 70 L60 70 L80 56 L150 56 L170 42 L240 42 L260 28 L330 28 L350 14 L400 14" stroke="currentColor" stroke-width="1.5" fill="none"/><path d="M0 78 L90 78 L110 64 L190 64 L210 50 L290 50 L310 36 L400 36" stroke="currentColor" stroke-width="1" fill="none" opacity=".5"/></svg>}
            {index === 1 && <svg class="industry-terrain" viewBox="0 0 400 78" preserveAspectRatio="none" aria-hidden="true"><path d="M40 78 V26 M40 26 L120 78 M120 78 V18 M120 18 L210 78 M210 78 V30 M210 30 L300 78 M300 78 V12 M300 12 L380 60" stroke="currentColor" stroke-width="1.5" fill="none"/><path d="M20 78 H400" stroke="currentColor" stroke-width="1" opacity=".5"/></svg>}
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section value-section">
    <div class="shell">
      <div class="section-title title-stack"><div class="eyebrow">Value</div><h2>What changes in how you work.</h2><p>TechSafeAI does not guarantee productivity, profitability or compliance outcomes — it helps connect the intelligence that informs them.</p></div>
      <div class="value-grid reveal-group">
        {valueOutcomes.map((v)=>(
          <div class="value-panel">
            <span class="value-icon" aria-hidden="true"><Icon name={v.icon} size={20} /></span>
            <h3>{v.name}</h3>
            <i class="value-sheen" aria-hidden="true"></i>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CtaBand title="Operational Intelligence backed by operational expertise." copy="A person from TechSafeAI reviews every enquiry. Your existing systems remain authoritative and human decisions remain human." />

  <script src="../scripts/premium/index.ts"></script>
</BaseLayout>

<style>
  /* claude/109 — homepage downstream mission: compact 4-theme proof-band
     label row above the Evidence & Human Review boundary band. Page-scoped
     only; reuses the section's existing light/navy palette, no new tokens. */
  .proof-themes{
    margin:18px 0 0;text-align:center;
    font:700 11px/1.4 ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;
    letter-spacing:.10em;text-transform:uppercase;color:#0b6e9a;
  }
  .proof-themes i{display:inline-block;width:3px;height:3px;margin:0 12px 2px;border-radius:50%;background:rgba(45,184,249,.55);vertical-align:middle}
</style>
