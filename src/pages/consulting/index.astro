---
import ContentPage from '../../components/ContentPage.astro';
import Icon from '../../components/Icon.astro';
import BrandMark from '../../components/BrandMark.astro';

// claude/96 — FOUNDER CORRECTION #2: this page still read as a
// capability document, not a website page. Cut further: the
// methodology block collapses from a tall panel into one compact
// horizontal 8-step strip (label only, no per-step description copy);
// the two-column "Operational Intelligence backed by operational
// expertise" explanatory section is replaced by a single slim proof
// line (Human-led + Evidence-backed + Governed AI), matching the
// homepage's own .trust-strip pattern; inter-section vertical spacing
// is compressed page-wide. Final structure, exactly as directed:
// Hero -> three pillars -> methodology strip -> proof line -> CTA.
//
// claude/97 — Founder approved v96 as the Consulting baseline, with
// two small polish items: (1) the methodology heading read as
// "slightly consulting-heavy" — changed to the Founder's own preferred
// simpler alternative, "How TechSafeAI works"; (2) the hero graphic's
// four icon tiles read as "slightly generic" with no explicit meaning
// — each tile now carries a one-word caption (Evidence / Review /
// Assurance / Judgement) so the same physical cockpit tiles read as
// intended, without changing geometry, icons or adding new elements
// ("do not overbuild it"). Every string is still sourced from
// already-published, governed copy — sources noted inline.

const stages = [
  'UNDERSTAND', 'PROTECT', 'AUTHORITY', 'EVIDENCE', 'GAPS', 'TRANSFORM', 'VERIFY', 'VALUE'
] as const;

// Three consulting capability pillars — unchanged from claude/95.
// Grouping/pillar names are Founder-specified; each summary is reused
// verbatim from src/data/site.ts `consultingServices` (closest-matching
// existing service item per pillar) — no new capability or claim.
const pillars = [
  {
    title: 'Operational Assurance', icon: 'shield-check',
    // consultingServices: 'Operational Risk & Assurance'
    copy: 'Structured review of operational risk exposure, controls and assurance activity.'
  },
  {
    title: 'Operational Improvement', icon: 'loop',
    // consultingServices: 'Operational Reviews'
    copy: 'Independent review of workflow, ownership and operating effectiveness.'
  },
  {
    title: 'Digital Transformation', icon: 'chip',
    // consultingServices: 'Digital & AI Transformation'
    copy: 'Move stalled digital or AI initiatives into governed, accountable operating change.'
  }
] as const;

// One short proof line (claude/96) — replaces the claude/95 two-column
// positioning section. Each phrase is grounded in this page's own
// eyebrow ("Human-led expertise") and existing governed copy already
// used elsewhere on this page/site: "Evidence-led. Human review."
// (this page's hero) and "governed Operational Intelligence platform"
// / "Contextual, evidence-grounded and human-supervised." (site.ts
// description; src/pages/index.astro SAI section). Not new claims —
// a compression of copy already on the site into three short labels.
const proof = [
  { icon: 'person', label: 'Human-led' },
  { icon: 'doc-check', label: 'Evidence-backed' },
  { icon: 'shield-check', label: 'Governed AI' }
] as const;
---
<ContentPage
  title="Consulting"
  eyebrow="Human-led expertise"
  intro="Human-led expertise for high-risk operations."
>
  <Fragment slot="hero-graphic">
    <!-- claude/97 — same tiles/geometry as claude/94/95; each now
         carries a one-word caption per Founder direction so the
         meaning (Evidence / Review / Assurance / Judgement) is
         explicit rather than icon-only. -->
    <div class="gov-graphic">
      <div class="gov-glass">
        <span class="gov-title">Evidence-led.<br/>Human review.</span>
        <span class="gov-seam" aria-hidden="true"></span>
        <div class="gov-tiles">
          <span class="gov-tile" aria-hidden="true"><Icon name="doc-check" size={16} /><em>Evidence</em></span>
          <span class="gov-tile" aria-hidden="true"><Icon name="person-check" size={16} /><em>Review</em></span>
          <span class="gov-tile" aria-hidden="true"><Icon name="seal-check" size={16} /><em>Assurance</em></span>
          <span class="gov-tile" aria-hidden="true"><Icon name="shield-check" size={16} /><em>Judgement</em></span>
          <div class="gov-hub" aria-hidden="true"><BrandMark size={26} compact={true} /></div>
        </div>
      </div>
    </div>
  </Fragment>

  <section class="content-section pillars-section">
    <div class="shell">
      <div class="section-title"><div><div class="eyebrow">Consulting capability</div><h2>Three ways to work with TechSafeAI consultants.</h2></div></div>
      <div class="pillar-grid" style="margin-top:24px">
        {pillars.map((p)=>(
          <div class="pillar-card">
            <span class="pillar-icon" aria-hidden="true"><Icon name={p.icon} size={22} /></span>
            <h3>{p.title}</h3>
            <p>{p.copy}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="content-section method-section">
    <div class="shell">
      <div class="section-title"><div><div class="eyebrow">Consulting methodology</div><h2>How TechSafeAI works.</h2></div></div>
      <div class="method-strip">
        {stages.map((stage,i)=>(
          <div class="method-step">
            <span class="method-step-index">0{i+1}</span>
            <span class="method-step-label">{stage}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="content-section proof-strip">
    <div class="shell proof-row">
      {proof.map((item)=>(
        <span class="proof-tag"><Icon name={item.icon} size={18} /><span>{item.label}</span></span>
      ))}
    </div>
  </section>
</ContentPage>

<style>
  /* claude/96 — further compression. Page-wide: base section padding
     cut on this page only (scoped rule below overrides the global
     .content-section{padding:88px 0} from components.css). Pillars
     unchanged from claude/95. Methodology becomes a single-row strip
     (label + index only, connected by one thin rail line) instead of
     the previous full descriptive list panel. The old two-column
     "positioning" band is gone entirely, replaced by .proof-strip — a
     slim single-line band styled after the homepage's own
     .trust-strip (icon + short label, minimal vertical padding). */
  .content-section{padding:56px 0}

  .pillar-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
  .pillar-card{
    position:relative;overflow:hidden;
    background:linear-gradient(155deg,var(--panel-light-1) 0%,var(--panel-light-2) 100%);
    border:1px solid rgba(19,39,58,.10);border-radius:8px;
    padding:26px 24px 24px;box-shadow:var(--bevel-light-raised);
  }
  .pillar-card::before{content:"";position:absolute;left:0;top:16px;bottom:16px;width:2px;
    background:linear-gradient(180deg,transparent,var(--illum-line),transparent);opacity:.5}
  .pillar-icon{display:flex;align-items:center;justify-content:center;width:38px;height:38px;border-radius:8px;
    background:rgba(0,229,255,.08);border:1px solid rgba(0,229,255,.28);color:#0F7FA0;margin-bottom:14px}
  .pillar-card h3{margin:0 0 8px;font-size:19px}
  .pillar-card p{margin:0;font-size:13.5px;line-height:1.5;color:var(--text-secondary)}

  .method-section{background:var(--atmo-dark);padding:48px 0}
  .method-section .eyebrow{color:var(--illum)}
  .method-section .section-title h2{color:#FFFFFF}

  .method-strip{position:relative;display:flex;margin-top:36px;padding:0 4px}
  .method-strip::before{content:"";position:absolute;top:15px;left:2%;right:2%;height:1px;
    background:linear-gradient(90deg,transparent,var(--illum-line) 10%,var(--illum-line) 90%,transparent);opacity:.55}
  .method-step{position:relative;z-index:1;flex:1;display:flex;flex-direction:column;align-items:center;gap:10px;padding:0 4px;text-align:center}
  .method-step-index{display:flex;align-items:center;justify-content:center;width:30px;height:30px;border-radius:50%;flex-shrink:0;
    font:700 10px/1 var(--mono-label-font,ui-monospace,monospace);color:#0B1116;
    background:linear-gradient(180deg,#DCE8EE 0%,#C7DAE3 100%);box-shadow:0 1px 2px rgba(0,0,0,.35)}
  .method-step-label{font:700 10px/1.3 var(--mono-label-font,ui-monospace,monospace);letter-spacing:.05em;text-transform:uppercase;color:#C7DAE3}

  .proof-strip{padding:28px 0;background:var(--panel-light-2,#F4F7F9);border-top:1px solid rgba(19,39,58,.08);border-bottom:1px solid rgba(19,39,58,.08)}
  .proof-row{display:flex;align-items:center;justify-content:center;gap:36px;flex-wrap:wrap}
  .proof-tag{display:flex;align-items:center;gap:9px;font:700 13px/1 var(--mono-label-font,ui-monospace,monospace);letter-spacing:.03em;color:#28313A;border:0}
  .proof-tag :global(svg){color:#0F7FA0;flex-shrink:0}

  @media (max-width:900px){
    .pillar-grid{grid-template-columns:1fr}
  }
  @media (max-width:700px){
    .method-strip{flex-wrap:wrap;row-gap:24px;column-gap:12px}
    .method-strip::before{display:none}
    .method-step{flex:0 0 calc(25% - 9px)}
  }
  @media (max-width:480px){
    .method-step{flex:0 0 calc(50% - 6px)}
    .proof-row{gap:18px 28px}
  }

  /* Consulting hero graphic (claude/94, unchanged) */
  :global(.technical-panel:has(.gov-graphic))::after{display:none}
  .gov-graphic{position:relative;z-index:2;width:100%;height:100%;min-height:300px;
    padding:16px;border-radius:6px;border:1px solid var(--graphite-edge);
    background:var(--key-light),radial-gradient(160% 120% at 50% -20%,rgba(110,165,200,.07),transparent 62%),linear-gradient(180deg,var(--graphite-1) 0%,var(--graphite-2) 46%,var(--graphite-3) 100%);
    box-shadow:var(--bevel-raised),inset 0 0 0 1px rgba(255,255,255,.06);
    display:flex;align-items:center;justify-content:center}
  .gov-glass{position:relative;width:100%;height:100%;border-radius:4px;
    padding:22px 20px 20px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:14px;
    background:radial-gradient(130% 100% at 50% -14%,rgba(255,255,255,.08),transparent 58%),linear-gradient(165deg,#1B222A 0%,#171C22 60%,#15191E 100%);
    box-shadow:var(--bevel-recessed),inset 0 1px 0 rgba(255,255,255,.05)}
  .gov-title{max-width:220px;text-align:center;font:700 15px/1.35 var(--mono-label-font,ui-monospace,monospace);letter-spacing:.02em;text-transform:none;color:#C7DAE3}
  .gov-seam{width:34px;height:1px;background:linear-gradient(90deg,transparent,var(--illum-line),transparent)}
  .gov-tiles{position:relative;display:grid;grid-template-columns:1fr 1fr;grid-template-rows:1fr 1fr;gap:16px;width:100%;max-width:190px}
  .gov-tile{aspect-ratio:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:5px;border-radius:8px;
    background:linear-gradient(180deg,rgba(255,255,255,.06) 0%,rgba(255,255,255,0) 45%),var(--graphite-light-3);
    border:1px solid var(--graphite-edge);color:#8FE3F5;
    box-shadow:inset 0 1px 0 rgba(255,255,255,.12),inset 0 -3px 6px rgba(0,0,0,.45),0 0 0 1px rgba(255,255,255,.05)}
  .gov-tile em{font-style:normal;font:700 7.5px/1 var(--mono-label-font,ui-monospace,monospace);letter-spacing:.04em;text-transform:uppercase;color:#B9DCE6;opacity:.9}
  .gov-hub{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:50px;height:50px;border-radius:50%;
    background:radial-gradient(120% 120% at 34% 24%,rgba(255,255,255,.11),transparent 55%),var(--lvl0,#04090F);
    display:flex;align-items:center;justify-content:center;box-shadow:var(--bevel-recessed-illum);z-index:2}
  @media (max-width:520px){
    .gov-tiles{max-width:160px;gap:12px}
    .gov-hub{width:42px;height:42px}
  }
</style>
