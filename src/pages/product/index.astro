---
import ContentPage from '../../components/ContentPage.astro';
import BrandMark from '../../components/BrandMark.astro';
import { productTiers } from '../../data/site';

// Generic system categories only — no named vendors/products (Founder
// ruling, claude/86: real vendor logos require separate governed evidence
// before they can appear anywhere on the site). Layout per Founder review
// (claude/88): reverted to a symmetric 2-row/6-category grid, hub centred
// between the rows — "Operational Data" removed as a separate node (its
// coverage is now implied by "IMS" in the title, below) so the categories
// read as clean, discrete system types rather than a mixed list.
const VIEW_W = 560;
const VIEW_H = 240;
const SYSTEM_NODES = [
  { label: 'ERP', x: 100, y: 50 },
  { label: 'HRIS / LMS', x: 280, y: 50 },
  { label: 'EHS', x: 460, y: 50 },
  { label: 'CMMS / EAM', x: 100, y: 190 },
  { label: 'BI', x: 280, y: 190 },
  { label: 'Documents / Records', x: 460, y: 190 },
];
const HUB = { x: 280, y: 120 };
---
<ContentPage
  title="Product"
  eyebrow="Governed Operational Intelligence"
  intro="TechSafeAI connects, structures and explains governed operational information from the systems you already run. It does not replace them."
>
  <Fragment slot="hero-graphic">
    <!-- Presentation-only material upgrade (claude/89) — same content,
         structure and data as claude/86-88 (see SYSTEM_NODES/HUB above,
         unchanged). The graphic is now a recessed TechSafeAI instrument
         module in the locked hero's material language (satin graphite
         housing + smoked-glass inner panel + machined bevels + restrained
         cyan seams — see the CSS block below for the exact token
         mapping back to hero.css's .bay-frame/.laptop-screen). Scoped to
         this page only via PageHero's optional "graphic" slot — every
         other page keeps the prior default, untouched. -->
    <div class="sys-graphic">
      <div class="sys-glass">
        <span class="sys-title">Works with your existing IMS &amp; systems</span>
        <span class="sys-seam" aria-hidden="true"></span>
        <div class="sys-diagram" style={`aspect-ratio:${VIEW_W}/${VIEW_H}`}>
          <svg class="sys-lines" viewBox={`0 0 ${VIEW_W} ${VIEW_H}`} preserveAspectRatio="xMidYMid meet" aria-hidden="true">
            {SYSTEM_NODES.map((n) => (
              <line x1={n.x} y1={n.y} x2={HUB.x} y2={HUB.y} />
            ))}
          </svg>
          <div class="sys-hub" style={`left:${(HUB.x / VIEW_W) * 100}%;top:${(HUB.y / VIEW_H) * 100}%`}>
            <BrandMark size={30} compact={true} />
          </div>
          {SYSTEM_NODES.map((n) => (
            <div class="sys-node" style={`left:${(n.x / VIEW_W) * 100}%;top:${(n.y / VIEW_H) * 100}%`}>{n.label}</div>
          ))}
        </div>
        <span class="sys-footer">API · MCP · Adapters</span>
      </div>
    </div>
  </Fragment>
  <section class="content-section">
    <div class="shell">
      <div class="section-title"><div><div class="eyebrow">Core</div><h2>The governed Operational Intelligence platform.</h2></div><p>Available now, built around your existing systems and human review.</p></div>
      <div class="indexed-list" style="margin-top:24px">
        {productTiers.core.map((item,i)=>(
          <div class="indexed-item"><span class="index">0{i+1}</span><div><h3>{item.title}</h3><p>{item.summary}</p></div></div>
        ))}
      </div>
      <figure class="asset-figure">
        <div class="asset-crop">
          <img
            src="/assets/sai/website-handoff/sai-ui-016/HERO-COCKPIT-37a6918.png"
            width="1506"
            height="692"
            alt="TechSafeAI Operational Intelligence cockpit shown with synthetic demonstration data."
            loading="lazy"
          />
        </div>
        <figcaption class="notice">Product interface shown with synthetic demonstration data.</figcaption>
      </figure>
    </div>
  </section>

  <section class="content-section" style="background:#e8e5dd">
    <div class="shell">
      <div class="section-title"><div><div class="eyebrow">Assurance</div><h2>Evidence, controls and change over time.</h2></div><p>Structures the evidence and verification work that sits behind an assurance position.</p></div>
      <div class="indexed-list" style="margin-top:24px">
        {productTiers.assurance.map((item,i)=>(
          <div class="indexed-item"><span class="index">0{i+1}</span><div><h3>{item.title}</h3><p>{item.summary}</p></div></div>
        ))}
      </div>
    </div>
  </section>

  <section class="content-section">
    <div class="shell">
      <div class="section-title"><div><div class="eyebrow">Enterprise</div><h2>Multi-site, integrated, configurable.</h2></div><p>For organisations operating across more than one site or portfolio.</p></div>
      <div class="indexed-list" style="margin-top:24px">
        {productTiers.enterprise.map((item,i)=>(
          <div class="indexed-item"><span class="index">0{i+1}</span><div><h3>{item.title}</h3><p>{item.summary}</p></div></div>
        ))}
      </div>
    </div>
  </section>

  <section class="content-section" style="background:#e8e5dd">
    <div class="shell">
      <div class="section-title"><div><div class="eyebrow">Operations — Future</div><h2>Planned capability, not yet delivered.</h2></div><p class="notice">Work Preparation Intelligence is future capability. It is not currently delivered and is shown here for transparency about direction, not as a live feature.</p></div>
      <div class="indexed-list" style="margin-top:24px">
        {productTiers.future.map((item,i)=>(
          <div class="indexed-item"><span class="index">FUTURE</span><div><h3>{item.title}</h3><p>{item.summary}</p></div></div>
        ))}
      </div>
    </div>
  </section>
</ContentPage>

<style>
  .asset-figure{margin:32px 0 0;max-width:1506px}
  .asset-crop{overflow:hidden;aspect-ratio:1506/580;border:1px solid var(--border);background:var(--surface-0)}
  .asset-crop img{display:block;width:100%;height:auto}
  .asset-figure figcaption{margin-top:12px}

  /* Hero systems-connectivity graphic (claude/86, refined claude/87-88,
     material upgrade claude/89) — lives inside the shared .technical-panel
     (border/min-height unchanged, from components.css); everything below
     is scoped to this page. .sys-graphic (the outer housing) fully covers
     .technical-panel's own flat background, so this page reads as a
     distinct instrument module without editing that shared rule.
     The line below removes .technical-panel's own ::after (the legacy
     diagonal "trend line" from the old dots/line graphic, defined in
     components.css) — but ONLY on a .technical-panel that contains
     .sys-graphic, i.e. only on this page. :global() is required because
     .technical-panel is authored in PageHero.astro, not here, so Astro's
     automatic per-file scoping can't reach it; :has(.sys-graphic) keeps
     the effect scoped to this page in practice, since .sys-graphic exists
     nowhere else. Every other page's .technical-panel::after is completely
     untouched.
     Material language is pulled from the Stage 1 reconciled tokens
     (tokens.css) rather than re-derived — those tokens are the same
     values the locked hero's .bay-frame/.laptop-screen use in hero.css,
     so this panel reads as the same manufactured family without copying
     hero-specific markup (no cowl, no side towers, no screen-glass glare
     — deliberately not a cockpit, just a housed sub-panel). */
  :global(.technical-panel:has(.sys-graphic))::after{display:none}

  /* Outer housing — satin graphite, raking key-light, raised bevel. */
  .sys-graphic{position:relative;z-index:2;width:100%;height:100%;min-height:300px;
    padding:16px;border-radius:6px;border:1px solid var(--graphite-edge);
    background:var(--key-light),linear-gradient(180deg,var(--graphite-1) 0%,var(--graphite-2) 46%,var(--graphite-3) 100%);
    box-shadow:var(--bevel-raised);
    display:flex;align-items:center;justify-content:center}

  /* Inner smoked-glass panel — recessed (shallow inset bevel, no cyan
     ring here; the ring is reserved for the hub so the cyan stays a
     restrained accent, not a screen edge). Diagram content lives inside. */
  .sys-glass{position:relative;width:100%;height:100%;border-radius:4px;
    padding:20px 18px 14px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:9px;
    background:radial-gradient(130% 100% at 50% -14%,rgba(255,255,255,.05),transparent 55%),linear-gradient(165deg,#0C131B 0%,#080D13 60%,#060A0F 100%);
    box-shadow:var(--bevel-recessed)}
  .sys-title{max-width:260px;text-align:center;font:700 10px/1.35 var(--mono-label-font,ui-monospace,monospace);letter-spacing:.12em;text-transform:uppercase;color:#9DB4C4}
  /* single restrained cyan seam beneath the title — echoes the hero's
     cyan-lit cut-lines without any glow/bloom */
  .sys-seam{width:34px;height:1px;background:linear-gradient(90deg,transparent,var(--illum-line),transparent)}
  .sys-diagram{position:relative;width:100%;max-width:460px}
  .sys-lines{position:absolute;inset:0;width:100%;height:100%}
  .sys-lines line{stroke:rgba(0,229,255,.30);stroke-width:1.25;stroke-dasharray:4 5}
  /* embedded central node — the one deliberately illuminated element,
     using the same recessed+cyan-ring token as the hero's screen chamber */
  .sys-hub{position:absolute;transform:translate(-50%,-50%);width:68px;height:68px;border-radius:50%;
    background:radial-gradient(120% 120% at 34% 24%,rgba(255,255,255,.08),transparent 55%),var(--lvl0,#04090F);
    display:flex;align-items:center;justify-content:center;
    box-shadow:var(--bevel-recessed-illum)}
  /* inset machined chips — shallow recess + top highlight, not flat */
  .sys-node{position:absolute;transform:translate(-50%,-50%);width:138px;min-height:34px;display:flex;align-items:center;justify-content:center;text-align:center;font-family:Montserrat,Arial,sans-serif;font-weight:700;font-size:11px;line-height:1.25;letter-spacing:.02em;color:#DCE8EE;
    background:linear-gradient(180deg,rgba(255,255,255,.05) 0%,rgba(255,255,255,0) 45%),var(--graphite-light-3);
    border:1px solid var(--graphite-edge);border-radius:4px;padding:6px 10px;
    box-shadow:inset 0 1px 0 rgba(255,255,255,.10),inset 0 -3px 6px rgba(0,0,0,.45),0 0 0 1px rgba(255,255,255,.04)}
  .sys-footer{font:700 9px/1.3 var(--mono-label-font,ui-monospace,monospace);letter-spacing:.12em;text-transform:uppercase;color:rgba(0,229,255,.60)}
  @media (max-width:520px){
    .sys-graphic{padding:12px}
    .sys-glass{padding:16px 14px 12px}
    .sys-node{width:110px;font-size:9.5px;padding:5px 7px}
    .sys-hub{width:56px;height:56px}
  }
</style>
