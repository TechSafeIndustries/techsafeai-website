---
import ContentPage from '../../components/ContentPage.astro';
import Icon from '../../components/Icon.astro';

// claude/104 — FOUNDER CORRECTION on claude/103: the page read as
// inward-looking (publishing philosophy) rather than visitor-facing
// (what can be learned here). Structure/visual language unchanged;
// copy rewritten to the Founder's own plain-language purpose lines
// (verbatim per section below), and the "Publishing standard /
// Substance before volume" editorial-process section is removed
// outright (see REMOVED note near the old section's former location).
//
// EVIDENCE NOTE (still true, carried from claude/103): this repo
// holds no published insight/article content anywhere — no content
// collection, no article routes, no slugs. Per this correction's own
// instruction, the "Selected / Future Insights" area below is a
// neutral placeholder statement, not a fabricated article list — no
// invented titles, dates, authors or counts.
const heroThemeIcons = ['nodes', 'cite', 'person-check'] as const;

// THEMES — claude/104. Titles and one-line purposes are verbatim from
// the Founder's own "REVISED STRUCTURE" brief (section 2, items A/B/C).
// Icons unchanged from claude/103 (same three, same page-scoped
// meaning). The previous per-theme "topics" tag line (verbatim
// fragments of this page's old eight-topic list) is dropped here —
// the Founder's correction asks for one concise plain-language purpose
// per theme, not a sourced-fragment list; nothing from those eight
// topic strings is presented elsewhere on this page.
const themes = [
  {
    icon: 'nodes',
    title: 'Operational Intelligence',
    summary: 'Practical guidance on controls, evidence, performance and operational visibility.'
  },
  {
    icon: 'cite',
    title: 'Governance & Evidence',
    summary: 'How organisations can build defensible evidence, assurance and AI governance.'
  },
  {
    icon: 'person-check',
    title: 'Human + AI',
    summary: 'How governed AI can support people without replacing human judgement.'
  }
] as const;
---
<ContentPage
  title="Insights"
  eyebrow="Evidence-led thinking"
  intro="Practical thinking on Operational Intelligence, governance, evidence and responsible AI in high-risk operations."
>
  <Fragment slot="hero-graphic">
    <div class="ins-graphic">
      <div class="ins-glass">
        <span class="ins-title">Practical thinking.<br/>Evidence-led.</span>
        <span class="ins-seam" aria-hidden="true"></span>
        <div class="ins-tiles">
          {heroThemeIcons.map((icon)=>(
            <span class="ins-tile" aria-hidden="true"><Icon name={icon} size={18} /></span>
          ))}
        </div>
      </div>
    </div>
  </Fragment>

  <section class="content-section themes-section">
    <div class="shell">
      <div class="section-title"><div><div class="eyebrow">Insight themes</div><h2>Three lines of thinking, not a catalogue.</h2></div></div>
      <div class="theme-grid" style="margin-top:24px">
        {themes.map((t)=>(
          <div class="theme-card">
            <span class="theme-icon" aria-hidden="true"><Icon name={t.icon} size={22} /></span>
            <h3>{t.title}</h3>
            <p>{t.summary}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- claude/104 — Selected / Future Insights: no published items exist
       in this repo (see evidence note above), so per the Founder's own
       instruction this is a neutral placeholder, not a fabricated
       article list. No titles, dates, authors or counts. -->
  <section class="content-section future-section">
    <div class="shell">
      <div class="section-title"><div><div class="eyebrow">Selected insights</div><h2>Selected Insights will appear here as they are published.</h2></div></div>
    </div>
  </section>
</ContentPage>

<style>
  /* claude/103 — Insights, built to the same compact-density rule as
     Why TechSafeAI/Consulting/Industries. Deliberately shorter than
     those three (two body sections, not three) — there is no
     published article inventory yet to justify a third "recent
     insights" band (see the evidence note above); the page stays
     honest about that rather than padded out to match. */
  .content-section{padding:56px 0}

  /* Insight themes — three engineered light cards, same material
     language (bevel + inset hairline, graphite icon tile) now
     established across the site's other locked pages. */
  .theme-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
  .theme-card{
    position:relative;overflow:hidden;
    background:linear-gradient(155deg,var(--panel-light-1) 0%,var(--panel-light-2) 100%);
    border:1px solid rgba(19,39,58,.10);border-radius:8px;
    padding:22px 20px 20px;box-shadow:var(--bevel-light-raised),inset 0 0 0 1px rgba(19,39,58,.05);
  }
  .theme-card::before{content:"";position:absolute;left:0;top:16px;bottom:16px;width:2px;
    background:linear-gradient(180deg,transparent,var(--illum-line),transparent);opacity:.5}
  .theme-icon{display:flex;align-items:center;justify-content:center;width:36px;height:36px;border-radius:8px;
    background:linear-gradient(180deg,rgba(255,255,255,.06) 0%,rgba(255,255,255,0) 45%),var(--graphite-light-3);
    border:1px solid var(--graphite-edge);color:#6FCEFB;margin-bottom:12px;
    box-shadow:inset 0 1px 0 rgba(255,255,255,.12),inset 0 -3px 6px rgba(0,0,0,.45),0 0 0 1px rgba(255,255,255,.05)}
  .theme-card h3{margin:0 0 8px;font-size:16px}
  .theme-card p{margin:0;font-size:13px;line-height:1.5;color:var(--text-secondary)}

  /* Selected insights placeholder (claude/104) — compact dark band,
     one neutral line, no card/grid: there is nothing to list yet, so
     this is a statement, not a section pretending to hold content. */
  .future-section{background:var(--atmo-dark);padding-top:40px;padding-bottom:40px}
  .future-section .eyebrow{color:var(--illum)}
  .future-section .section-title h2{color:#C7DAE3;font-size:19px;font-weight:700}

  @media (max-width:900px){
    .theme-grid{grid-template-columns:1fr}
  }

  /* Insights hero graphic — same graphite/smoked-glass housing as the
     other locked pages' hero panels, fresh .ins-* class names so
     nothing here touches any other page. Three tiles (not four/2x2)
     previewing the three themes above; no hub — three items reads
     cleanly as a single row rather than forcing a fourth element. */
  :global(.technical-panel:has(.ins-graphic))::after{display:none}
  .ins-graphic{position:relative;z-index:2;width:100%;height:100%;min-height:300px;
    padding:16px;border-radius:6px;border:1px solid var(--graphite-edge);
    background:var(--key-light),radial-gradient(160% 120% at 50% -20%,rgba(110,165,200,.07),transparent 62%),linear-gradient(180deg,var(--graphite-1) 0%,var(--graphite-2) 46%,var(--graphite-3) 100%);
    box-shadow:var(--bevel-raised),inset 0 0 0 1px rgba(255,255,255,.06);
    display:flex;align-items:center;justify-content:center}
  .ins-glass{position:relative;width:100%;height:100%;border-radius:4px;
    padding:22px 20px 20px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:14px;
    background:radial-gradient(130% 100% at 50% -14%,rgba(255,255,255,.08),transparent 58%),linear-gradient(165deg,#1B222A 0%,#171C22 60%,#15191E 100%);
    box-shadow:var(--bevel-recessed),inset 0 1px 0 rgba(255,255,255,.05)}
  .ins-title{max-width:230px;text-align:center;font:700 15px/1.35 var(--mono-label-font,ui-monospace,monospace);letter-spacing:.02em;text-transform:none;color:#C7DAE3}
  .ins-seam{width:34px;height:1px;background:linear-gradient(90deg,transparent,var(--illum-line),transparent)}
  .ins-tiles{display:flex;gap:16px;width:100%;max-width:280px;justify-content:center}
  .ins-tile{aspect-ratio:1;width:64px;display:flex;align-items:center;justify-content:center;border-radius:8px;
    background:linear-gradient(180deg,rgba(255,255,255,.06) 0%,rgba(255,255,255,0) 45%),var(--graphite-light-3);
    border:1px solid var(--graphite-edge);color:#A8ECFA;
    box-shadow:inset 0 1px 0 rgba(255,255,255,.16),inset 0 -3px 6px rgba(0,0,0,.48),0 0 0 1px rgba(255,255,255,.08)}
  @media (max-width:520px){
    .ins-tiles{max-width:220px;gap:12px}
    .ins-tile{width:52px}
  }
</style>
