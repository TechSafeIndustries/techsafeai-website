---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { painPoints } from '../../data/site';
---
<BaseLayout title="Start with your challenge" description="Start with high-level business context. Do not provide confidential or protected information through the public website." noindex={true}>
<PageHero eyebrow="Preliminary business context" title="Start with your challenge" intro="Start with context, not confidential files. Online enquiry submission is not yet available." />
<section class="content-section"><div class="shell safe-intake"><div class="safe-intake-panel"><div class="eyebrow">Information we’ll ask for</div><h2>Enough context for a useful first discussion.</h2><ul><li>Primary business problem</li><li>Organisation and function</li><li>Industry, activity and operating environment</li><li>Jurisdiction</li><li>Desired outcome and timing</li><li>High-level internal capability</li><li>High-level security requirements</li><li>Business contact information</li></ul><p class="warning notice"><strong>Do not provide:</strong> incident files, personal records, credentials, restricted contracts, legal advice, evidence packs, system exports or detailed cyber architecture.</p></div><div class="disabled-form" aria-label="Enquiry form preview"><p class="preview-only">ONLINE ENQUIRY SUBMISSION IS NOT YET AVAILABLE.</p><div class="form-field"><label for="challenge">Primary challenge</label><select id="challenge" disabled><option>Select a challenge</option>{painPoints.map((pain)=><option>{pain.label}</option>)}</select></div><div class="form-field"><label for="organisation">Organisation</label><input id="organisation" disabled placeholder="Organisation name" /></div><div class="form-field"><label for="context">High-level context</label><textarea id="context" disabled maxlength="300" placeholder="Problem summary — 300 characters maximum"></textarea></div><button class="button button-primary" type="button" disabled aria-disabled="true">Online submission unavailable</button><p style="font-size:12px;color:#4f6571">No information entered on this page is submitted or stored.</p></div></div></section>
</BaseLayout>
