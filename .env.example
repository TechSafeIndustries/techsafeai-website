# WEB-01G/P1 server-side enquiry transport foundation.
# Production transport intentionally fails closed until a later gate configures a real provider.
DEPLOYMENT_ENVIRONMENT=development
ENQUIRY_TRANSPORT_MODE=unconfigured

# Development/test transport requires BOTH values below.
# Production code rejects test transport when DEPLOYMENT_ENVIRONMENT=production,
# even if either test setting is accidentally supplied.
ALLOW_TEST_ENQUIRY_TRANSPORT=0

# Optional server-side Turnstile validation. Leave blank unless configured in a later gate.
TURNSTILE_SECRET_KEY=

# Optional comma-separated additional origins for controlled non-production validation.
ALLOWED_ENQUIRY_ORIGINS=
