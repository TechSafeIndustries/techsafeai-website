# WEB-01G/P2 server-side enquiry transport foundation.
DEPLOYMENT_ENVIRONMENT=development
ENQUIRY_TRANSPORT_MODE=unconfigured

# Development/test transport requires BOTH values below.
# Production code rejects test transport even if these are misconfigured.
ALLOW_TEST_ENQUIRY_TRANSPORT=0

# HubSpot provider configuration. Do not commit real values.
# Staging HubSpot mode is permitted only with HUBSPOT_ACCOUNT_CLASS=developer-test.
HUBSPOT_ACCOUNT_CLASS=
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_PIPELINE_ID=
HUBSPOT_ENQUIRY_STAGE_ID=
HUBSPOT_API_BASE_URL=https://api.hubapi.com

# Turnstile remains optional unless TURNSTILE_REQUIRED=1.
# P2 validation uses Cloudflare's published dummy keys in CI, not production keys.
TURNSTILE_REQUIRED=0
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=
TURNSTILE_EXPECTED_ACTION=

# Optional comma-separated additional origins for controlled non-production validation.
ALLOWED_ENQUIRY_ORIGINS=
